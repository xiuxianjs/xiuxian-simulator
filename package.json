{
  "author": "ningmengchongshui",
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "axios": "1.19.0",
    "bcryptjs": "^3.0.3",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "dotenv": "^18.0.4",
    "jsxp": "^1.4.0",
    "lodash-es": "^4.17.21",
    "minio": "^8.0.7",
    "node-schedule": "^2.1.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.3"
  },
  "description": "修仙",
  "exports": {
    ".": "./lib/index.js",
    "./package": "./package.json"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "main": "./lib/index.js",
  "name": "xiuxian-game",
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "app": "node index.js",
    "dev": "lvy app.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --ext .ts,.tsx,.js --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx,.js --fix --max-warnings=0",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "precommit": "lint-staged",
    "start": "pm2 startOrRestart pm2.config.cjs",
    "stop": "pm2 stop pm2.config.cjs",
    "view": "lvy app.ts --jsxp",
    "test:framework": "node tools/run-framework-tests.mjs",
    "test:framework:types": "tsgo --noEmit -p test/framework/tsconfig.json",
    "test": "yarn test:framework:offline",
    "test:framework:offline": "node tools/run-framework-tests.mjs --offline",
    "test:framework:audit": "node tools/audit-framework-tests.mjs"
  },
  "type": "module",
  "version": "0.0.6",
  "gitHead": "c9666657eb63e089ef7fd6227112da8781ff843e"
}
